# ---------- Admin (REQUIRED in production) ----------
# Min 12 chars. The dev fallback ("idevia") is refused when NODE_ENV=production.
ADMIN_PASSWORD=change-me-to-a-strong-password
# Min 32 random chars. Signs the admin session cookie.
ADMIN_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# ---------- Database ----------
# Default: local SQLite file (./data/idevia.db). Optional override:
# IDEVIA_DB_PATH=./data/idevia.db

# Supabase (optional). When BOTH are set the app switches to Supabase.
# Run supabase/schema.sql first. Use the SERVICE ROLE key: it is server-only
# and never sent to the browser. Do NOT put NEXT_PUBLIC_ in front of these.
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJ...
